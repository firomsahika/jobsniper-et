# ==========================================
# JobSniper ET - Environment Configuration
# ==========================================

# Environment Mode: development / staging / production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: Webhook URL (leave empty for Long Polling in development)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret

# ------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------
POSTGRES_USER=jobsniper
POSTGRES_PASSWORD=jobsniper_secure_password
POSTGRES_DB=jobsniper_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Async connection URL
DATABASE_URL=postgresql+asyncpg://jobsniper:jobsniper_secure_password@localhost:5434/jobsniper_db

# ------------------------------------------
# Redis Configuration (FSM, Deduplication, Queue)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# Security & Encryption (AES-256-GCM)
# ------------------------------------------
# 32-byte URL-safe base64 key for encrypting CV text in DB.
# Generate via: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CV_ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfZHVtbXlfa2V5X2Zvcl9kZXZlbG9wbWVudF8=

# ------------------------------------------
# MTProto Telegram Client (Channel Listener)
# ------------------------------------------
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=jobsniper_listener
# Optional: Extra comma-separated public channel usernames to monitor
CUSTOM_JOB_CHANNELS=

# ------------------------------------------
# Alerting & Matching Thresholds
# ------------------------------------------
DEFAULT_MIN_MATCH_SCORE=80
STAGE1_VECTOR_THRESHOLD=0.70
DEDUPLICATION_SIMILARITY_THRESHOLD=0.92
OUTBOUND_RATE_LIMIT_PER_SEC=25

